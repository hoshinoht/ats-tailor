% Entry header: the title wraps inside its own box, so the date can never be
% pushed onto a later line (an ATS reads that as a range missing its end).
% The row is set to \textwidth explicitly: a trailing \\ (project headers have
% one, for the Technologies line) ends the line without stretching \hfill, which
% would otherwise leave the project dates short of the right margin.
\newcommand{\entryhead}[2]{%
  \noindent\hbox to \textwidth{%
    \begin{minipage}[t]{0.78\textwidth}\raggedright #1\end{minipage}%
    \hfill
    \begin{minipage}[t]{0.20\textwidth}\raggedleft #2\end{minipage}%
  }%
}
