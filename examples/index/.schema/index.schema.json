      "required": [
        "institution",
        "degree",
        "field",
        "period"
      ],
      "title": "Education",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "type": {
          "enum": [
            "role",
            "project",
            "cert"
          ],
          "title": "Type",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "ref",
        "type"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "A date range with year or year-month precision.\n\n``start``/``end`` are ``YYYY`` or ``YYYY-MM``; ``end`` may also be\n``present``. Rendering back to the v1 string form is done by :meth:`format`.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Period",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
