{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Bullet": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "responsibility",
            "impact"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "variants": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Variants",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "Bullet",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "A date range with year or year-month precision.\n\n``start``/``end`` are ``YYYY`` or ``YYYY-MM``; ``end`` may also be\n``present``. Rendering back to the v1 string form is done by :meth:`format`.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Period",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "company": {
      "title": "Company",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "type": {
      "enum": [
        "internship",
        "research",
        "fulltime"
      ],
      "title": "Type",
      "type": "string"
    },
    "period": {
      "$ref": "#/$defs/Period"
    },
    "hidden": {
      "default": false,
      "title": "Hidden",
      "type": "boolean"
    },
    "skills": {
      "items": {
        "type": "string"
      },
      "title": "Skills",
      "type": "array"
    },
    "keywords": {
      "items": {
        "type": "string"
      },
      "title": "Keywords",
      "type": "array"
    },
    "bullets": {
      "items": {
        "$ref": "#/$defs/Bullet"
      },
      "title": "Bullets",
      "type": "array"
    }
  },
  "required": [
    "id",
    "company",
    "title",
    "type",
    "period"
  ],
  "title": "Role",
  "type": "object"
}
