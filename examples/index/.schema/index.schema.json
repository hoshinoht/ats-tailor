{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Bullet": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "responsibility",
            "impact"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "variants": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Variants",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "Bullet",
      "type": "object"
    },
    "Certification": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "relevance": {
          "items": {
            "type": "string"
          },
          "title": "Relevance",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "issuer"
      ],
      "title": "Certification",
      "type": "object"
    },
    "Education": {
      "additionalProperties": false,
      "properties": {
        "institution": {
          "title": "Institution",
          "type": "string"
        },
        "degree": {
          "title": "Degree",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/Period"
