# SentenceTransformer model for semantic scoring
# Options: all-MiniLM-L6-v2, all-MiniLM-L12-v2, all-mpnet-base-v2
ATS_EMBED_MODEL=all-MiniLM-L12-v2

# Enable LLM keyword expansion (1/true/yes/on to enable; default disabled)
# ATS_LLM_EXPAND=true

# LLM model name (default: qwen3.5:4b)
# ATS_LLM_MODEL=qwen3.5:4b

# LLM backend: auto (try MLX → LM Studio → Ollama), mlx, lmstudio, ollama
# ATS_LLM_BACKEND=auto

# LLM temperature: single-pass (default: 0.3)
# ATS_LLM_TEMPERATURE=0.3

# Ollama context window size (default: 4096 3000~3100 English Words,
# increase for very long JDs)
# ATS_LLM_NUM_CTX=4096

# Two-pass domain-aware LLM expansion (1/true/yes to enable)
# Pass 1 infers relevant domains, pass 2 expands scoped keywords. ~2x latency.
# But higher precision for very long JDs with many domains.
ATS_LLM_TWO_PASS=false
# Two-pass temperatures: P1 domain classification (default: 0.2), P2 keyword expansion (default: 0.5)
# ATS_LLM_TEMPERATURE_P1=0.2
# ATS_LLM_TEMPERATURE_P2=0.5

# LM Studio server URL (default: http://localhost:1234)
# ATS_LMSTUDIO_URL=http://localhost:1234

# MLX model (HuggingFace repo ID, used when backend is mlx or auto)
# ATS_MLX_MODEL=mlx-community/Qwen3-8B-4bit

# Reranking: false (off), true (cross-encoder), or llm (the provider, listwise).
# Off by default on evidence — see docs/v2-design.md §8.
ATS_RERANK=false
# ATS_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# ATS_RERANK_TOP_K=5

# ── Typesetting ──────────────────────────────────────────────────────────────
# Which LaTeX engine compiles a rendered resume: auto | latexmk | tectonic.
# `auto` prefers latexmk when it is on PATH and falls back to Tectonic, which
# is what the container image ships instead of a TeX Live install. The parse
# and keyword checks read the PDF, so they are the same either way.
# ATS_LATEX_ENGINE=auto

# ── v2 engine (default since Phase 3c) ───────────────────────────────────────
# Selection engine: v2 covers parsed requirements, v1 ranks whole items.
# ATS_ENGINE=v2

# Who reads a posting into requirements and gates:
#   auto | ollama | lmstudio | mlx | none | external
# `auto` probes mlx → lmstudio → ollama and falls back to `none`. It is what
# `--llm` resolves to; with neither --llm nor --no-llm the provider is `none`
# unless this names one outright.
# ATS_LLM_PROVIDER=auto

# Ollama REST URL for the provider and v1 expansion alike.
# ATS_OLLAMA_URL=http://localhost:11434

# Seconds a generation may take, and seconds a health probe may take. The
# second is short on purpose: `auto` asks three hosts whether they exist.
# ATS_LLM_TIMEOUT=600
# ATS_LLM_PROBE_TIMEOUT=1.5

# Part of the extraction cache key: bump it when the prompt changes meaning.
# ATS_PROMPT_VERSION=extract-1

# Requirements kept from one posting, and the weight given to a deterministic
# requirement the extraction did not cover.
# ATS_MAX_REQUIREMENTS=40
# ATS_FALLBACK_REQ_WEIGHT=0.5

# Append the posting's job title to the Summary as a target statement.
# ATS_TARGET_TITLE=true

# Page budget
# ATS_MAX_EXPERIENCE=3
# ATS_MIN_EXPERIENCE=2
# ATS_MAX_PROJECTS=4
# ATS_MIN_PROJECTS=2
# ATS_MAX_SKILL_LINES=4
# ATS_MAX_PROJECT_BULLETS=3
# ATS_MIN_PROJECT_BULLETS=2
# ATS_MAX_EXP_BULLETS=3
# ATS_MIN_EXP_BULLETS=2
# ATS_MAX_CERTIFICATIONS=3
# ATS_MIN_CERTIFICATIONS=3
# ATS_CERT_THRESHOLD=0.20
# ATS_CHARS_PER_BULLET_LINE=80
# ATS_MAX_PAGE_LINES=72

# huggingface token for MLX LLM backend
# (leave empty if not using MLX or if your model is public)
HUGGINGFACE_TOKEN=

# "experience" or "projects" — higher-priority section is trimmed/dropped last
# ATS_SECTION_PRIORITY=experience
