{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Education": {
      "additionalProperties": false,
      "properties": {
        "institution": {
          "title": "Institution",
          "type": "string"
        },
        "degree": {
          "title": "Degree",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/Period"
        }
      },
      "required": [
        "institution",
        "degree",
        "field",
        "period"
      ],
      "title": "Education",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "A date range with year or year-month precision.\n\n``start``/``end`` are ``YYYY`` or ``YYYY-MM``; ``end`` may also be\n``present``. Rendering back to the v1 string form is done by :meth:`format`.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Period",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "education": {
      "items": {
        "$ref": "#/$defs/Education"
      },
      "title": "Education",
      "type": "array"
    }
  },
  "title": "EducationFile",
  "type": "object"
}
