{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Certification": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "relevance": {
          "items": {
            "type": "string"
          },
          "title": "Relevance",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "issuer"
      ],
      "title": "Certification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "certifications": {
      "items": {
        "$ref": "#/$defs/Certification"
      },
      "title": "Certifications",
      "type": "array"
    }
  },
  "title": "CertificationsFile",
  "type": "object"
}
