          "title": "Type",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "hidden": {
          "default": false,
          "title": "Hidden",
          "type": "boolean"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "bullets": {
          "items": {
            "$ref": "#/$defs/Bullet"
          },
          "title": "Bullets",
          "type": "array"
        }
      },
      "required": [
        "id",
        "company",
        "title",
        "type",
        "period"
      ],
      "title": "Role",
      "type": "object"
    },
    "Skill": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
