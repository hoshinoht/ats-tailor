          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "acronym": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
