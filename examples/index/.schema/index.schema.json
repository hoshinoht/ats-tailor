        "$ref": "#/$defs/Project"
      },
      "title": "Projects",
      "type": "array"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/Role"
      },
      "title": "Roles",
      "type": "array"
    },
    "certifications": {
      "items": {
        "$ref": "#/$defs/Certification"
      },
      "title": "Certifications",
      "type": "array"
    },
    "education": {
      "items": {
        "$ref": "#/$defs/Education"
      },
      "title": "Education",
      "type": "array"
    },
    "summaries": {
      "$ref": "#/$defs/Summaries"
    }
  },
  "title": "Index",
  "type": "object"
}
