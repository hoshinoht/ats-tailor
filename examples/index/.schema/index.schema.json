          "title": "Default"
        },
        "variants": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Variants",
          "type": "object"
        },
        "highlights": {
          "items": {
            "type": "string"
          },
          "title": "Highlights",
          "type": "array"
        }
      },
      "title": "Summaries",
      "type": "object"
    }
